# Copy to .env.local and fill in values. Never commit .env.local.

# Claude API key. Server only: never expose to the browser or prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Supabase project URL and anon (publishable) key. Safe for the browser: data is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (secret) key. Server only: bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
